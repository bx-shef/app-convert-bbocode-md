# --- APP SETTINGS ---
# The public URL of the application (e.g., https://example.com)
NUXT_PUBLIC_SITE_URL=

# Application base path (e.g., / or /some-folder/)
NUXT_APP_BASE_URL=

# --- SECURITY ---
# Comma-separated list of allowed hosts for Vite dev server NUXT_ALLOWED_HOSTS="example.com,foo.com"
NUXT_ALLOWED_HOSTS=

# --- API KEYS ---
# DeepSeek API Key (Get it at: https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_api_key_here

# --- DEPLOY: Joker (or any SSH host) ---
# Used by `pnpm deploy joker` and the deploy-joker.yml workflow.
JOKER_SSH_HOST=
JOKER_SSH_USER=
JOKER_SSH_PORT=22
JOKER_REMOTE_PATH=/var/www/app-convert-bbcode-md
# Path to private key on the machine running `pnpm deploy joker`.
# Leave empty to use the default ssh-agent / ~/.ssh/id_* keys.
JOKER_SSH_KEY_PATH=
