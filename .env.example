# --- APP SETTINGS ---
# The public URL of the application (e.g., https://example.com)
NUXT_PUBLIC_SITE_URL=

# Application base path (e.g., / or /some-folder/)
NUXT_APP_BASE_URL=

# --- ANALYTICS ---
# Cloudflare Web Analytics beacon token (cookieless). PUBLIC by design — it ships
# in the browser bundle, so it is NOT a secret. Empty = analytics disabled (the
# beacon <script> is not injected). Wired in nuxt.config.ts; kept OFF inside the
# Bitrix24 iframe. See docs/IMPROVEMENT_PLAN.md § Телеметрия.
NUXT_PUBLIC_CF_ANALYTICS_TOKEN=

# --- SECURITY ---
# Comma-separated list of allowed hosts for Vite dev server NUXT_ALLOWED_HOSTS="example.com,foo.com"
NUXT_ALLOWED_HOSTS=

# --- API KEYS ---
# DeepSeek API Key (Get it at: https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_api_key_here

# --- DEPLOY: Docker ---
# Used by `pnpm deploy docker [--push]` and the deploy-docker.yml workflow.
DOCKER_IMAGE=ghcr.io/bx-shef/app-convert-bbocode-md
DOCKER_TAG=latest
# Set to 1 to push after build (alternative to passing --push).
DOCKER_PUSH=
# Used by docker-compose.yml on the server.
HTTP_PORT=8080

# --- REPORTING (Telegram) ---
# reporting-kit: отчёты в Telegram через scripts/tg-send.sh.
# Бот для отправки отчётов (@BotFather -> /newbot -> токен).
TG_BOT_TOKEN=123456:AA-replace-with-real-token
# Единственный канал назначения — все отчёты идут сюда.
# Приватный канал/группа — числовой id вида -100...; публичный — @username.
# Бот должен быть в этом канале админом с правом публикации.
TG_CHAT_ID=-1001234567890
