# --- APP SETTINGS ---
# The public URL of the application (e.g., https://example.com)
NUXT_PUBLIC_SITE_URL=

# Application base path (e.g., / or /some-folder/)
NUXT_APP_BASE_URL=

# --- ANALYTICS ---
# Yandex.Metrika counter id (digits only). PUBLIC by design — ships in the
# browser bundle, NOT a secret. Empty = analytics disabled (nothing is injected).
# Read at BUILD time in nuxt.config.ts (baked into the bundle). This is the
# iframe-SAFE option: metrika.js is injected ONLY on the standalone converter
# page and self-mutes inside the B24 iframe (window.self !== window.top), so
# portal users are never tracked (принцип №4). Prefer this over the CF beacon.
NUXT_PUBLIC_YANDEX_COUNTER_ID=
#
# Cloudflare Web Analytics beacon token (cookieless). PUBLIC by design — it ships
# in the browser bundle, so it is NOT a secret. Empty = analytics disabled (the
# beacon <script> is not injected). Read at BUILD time in nuxt.config.ts (baked
# into the SSG bundle). NOTE: iframe-gating is NOT implemented for this beacon —
# when a token is set it injects unconditionally, incl. inside the B24 iframe.
# Enable at most ONE analytics option; prefer NUXT_PUBLIC_YANDEX_COUNTER_ID above
# (it is iframe-guarded). Do not enable this CF token until a client-side
# inbound-frame guard is added (принцип №4; see CLAUDE.md § Analytics/telemetry convention).
NUXT_PUBLIC_CF_ANALYTICS_TOKEN=

# --- FEEDBACK ---
# Public URL of an external worker that receives {title, body} and opens a GitHub
# issue in a PRIVATE bucket repo (app-convert-bbocode-md-feedback). The GitHub
# token lives IN THE WORKER — never in this SPA bundle (it is world-readable).
# This URL is public by design (just an endpoint), NOT a secret. Empty = the
# "report a bad conversion" button is hidden (fail-safe). Baked at BUILD time.
# The worker must handle CORS (OPTIONS preflight + Access-Control-Allow-Origin)
# and its own rate-limiting. If you serve via docker/nginx.conf and enforce CSP,
# add the worker origin to connect-src (see the note there).
NUXT_PUBLIC_FEEDBACK_URL=

# --- MARKETPLACE ---
# Bitrix24 Marketplace app slug/code (e.g. shef.bbcodemd) for the "rate this app"
# prompt shown inside the portal. Public, NOT a secret. Empty = prompt disabled
# (fail-safe). Baked at BUILD time. The prompt is portal-only and engagement-gated
# (see app/utils/app-rating.ts).
NUXT_PUBLIC_MARKETPLACE_SLUG=

# --- SECURITY ---
# Comma-separated list of allowed hosts for Vite dev server NUXT_ALLOWED_HOSTS="example.com,foo.com"
NUXT_ALLOWED_HOSTS=

# --- API KEYS ---
# DeepSeek API Key (Get it at: https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_api_key_here

# --- DEPLOY: Docker ---
# Used by `pnpm deploy docker [--push]` and the deploy-docker.yml workflow.
DOCKER_IMAGE=ghcr.io/bx-shef/app-convert-bbocode-md
DOCKER_TAG=latest
# Set to 1 to push after build (alternative to passing --push).
DOCKER_PUSH=
# Used by docker-compose.yml on the server.
HTTP_PORT=8080

# --- REPORTING (Telegram) ---
# reporting-kit: отчёты в Telegram через scripts/tg-send.sh.
# Бот для отправки отчётов (@BotFather -> /newbot -> токен).
TG_BOT_TOKEN=123456:AA-replace-with-real-token
# Единственный канал назначения — все отчёты идут сюда.
# Приватный канал/группа — числовой id вида -100...; публичный — @username.
# Бот должен быть в этом канале админом с правом публикации.
TG_CHAT_ID=-1001234567890
