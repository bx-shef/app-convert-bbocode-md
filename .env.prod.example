# Server profile (.env.prod) — read by docker-compose.prod.yml on the host.
# Copy to .env.prod and fill in. Never commit .env.prod itself.

## Image ########################################
# Pulled from GHCR (built by .github/workflows/deploy-docker.yml).
DOCKER_IMAGE=ghcr.io/bx-shef/app-convert-bbocode-md
# Pin to a SHA tag for reproducible deploys; `latest` is fine for hot-fixes.
DOCKER_TAG=latest

## Domain (consumed by nginx-proxy + acme-companion) ##
VIRTUAL_HOST=convert-bbocode-md.bx-shef.by
LETSENCRYPT_HOST=convert-bbocode-md.bx-shef.by
LETSENCRYPT_EMAIL=shevchik.mail@gmail.com

## NOTE on NUXT_PUBLIC_SITE_URL #################
# It is baked into dist/ at `docker build` time via --build-arg, NOT read at
# runtime. Setting it here changes nothing — set it in the deploy-docker.yml
# workflow inputs (or as an Actions variable) and rebuild the image.
